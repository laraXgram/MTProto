{
    "name": "laraxgram/mtproto",
    "description": "LaraGram MTProto Wrapper.",
    "keywords": ["laragram", "mtproto", "bot", "telegram"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laraxgram/mtproto/issues",
        "source": "https://github.com/laraxgram/mtproto"
    },
    "authors": [
        {
            "name": "laraXgram",
            "email": "laraxgram@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sockets": "*",
        "ext-zlib": "*"
    },
    "suggest": {
        "ext-swoole": "For better performance and features. (SwooleDriver)",
        "ext-openswoole": "For better performance and features. (SwooleDriver)",
        "ext-pcntl": "For better performance and features. (ForkDriver)",
        "revolt/event-loop": "For better performance and features. (AMPHPDriver)",
        "openswoole/core": "Openswoole IDE Helper for better development experience.",
        "swoole/ide-helper": "Swoole IDE Helper for better development experience."
    },
    "autoload": {
        "psr-4": {
            "LaraGram\\MTProto\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        },
        "laragram": {
            "providers": [
                "LaraGram\\MTProto\\Foundation\\ClientServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php bin/compile-tl.php"
        ],
        "post-root-package-install": [
            "@php bin/compile-tl.php"
        ],
        "compile-tl": [
            "@php bin/compile-tl.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
