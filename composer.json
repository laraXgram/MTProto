{
    "name": "laraxgram/mtproto",
    "description": "LaraGram MTProto Wrapper.",
    "keywords": ["laragram", "mtproto", "bot", "telegram"],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/laraxgram/mtproto/issues",
        "source": "https://github.com/laraxgram/mtproto"
    },
    "authors": [
        {
            "name": "laraXgram",
            "email": "laraxgram@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sockets": "*",
        "ext-zlib": "*",
        "laraxgram/surge": "^1"
    },
    "suggest": {
        "ext-swoole": "For non-blocking coroutine I/O. (SwooleDriver / Surge)",
        "ext-openswoole": "For non-blocking coroutine I/O. (SwooleDriver / Surge)",
        "openswoole/core": "Openswoole IDE Helper for better development experience.",
        "swoole/ide-helper": "Swoole IDE Helper for better development experience."
    },
    "autoload": {
        "psr-4": {
            "LaraGram\\MTProto\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        },
        "laragram": {
            "providers": [
                "LaraGram\\MTProto\\Foundation\\ClientServiceProvider"
            ]
        }
    },
    "bin": [
        "bin/compile-tl.php"
    ],
    "scripts": {
        "post-update-cmd": [
            "@php bin/compile-tl.php"
        ],
        "post-install-cmd": [
            "@php bin/compile-tl.php"
        ],
        "post-root-package-install": [
            "@php laragram install:client"
        ],
        "compile-tl": [
            "@php bin/compile-tl.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
